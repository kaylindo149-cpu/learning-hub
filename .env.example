GEMINI_API_KEY=your-gemini-api-key-here
# Optional. Defaults to gemini-2.5-flash for simple extraction/summarization.
GEMINI_MODEL=gemini-2.5-flash

# Slack link capture
SLACK_SIGNING_SECRET=your-slack-signing-secret
# Optional but recommended. Use the channel ID for #learning-hub, for example C012ABCDEF.
SLACK_LEARNING_HUB_CHANNEL_ID=
# Optional. Must match one of the app's category names.
SLACK_LEARNING_HUB_CATEGORY=Learn Later

# Optional for Vercel Slack capture storage. Use Upstash Redis or Vercel KV.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional. Defaults to learning-hub:slack-captured-links.
LEARNING_HUB_SLACK_LINKS_KEY=
